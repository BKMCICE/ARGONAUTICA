# pangu50k.fdc - pin + timing constraints for pangu50k_top (MES50HP, PGL50H-6FBG484)
create_clock -name {sys_clk} [get_ports {sys_clk}] -period {20.000} -waveform {0.000 10.000}
# cpu_clk is derived by the PLL; PDS infers it from GTP_PLL_E3 parameters. Explicit form:
create_generated_clock -name {cpu_clk} -source [get_ports {sys_clk}] [get_pins {u_pll.u_pll/CLKOUT0}] -master_clock [get_clocks {sys_clk}] -multiply_by {2} -divide_by {1}
set_clock_groups -asynchronous -group [get_clocks {sys_clk}] -group [get_clocks {cpu_clk}]

define_attribute {p:sys_clk} {PAP_IO_DIRECTION} {INPUT}

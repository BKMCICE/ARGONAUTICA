set_false_path -hold -from [get_pins -hierarchical {u_soc/frame_memory/transport/fifo/rg?9:0?/Q?8?}] -to [get_pins -hierarchical {u_soc/frame_memory/transport/fifo/rg_w1?9:0?/D?8?}]

set_false_path -hold -from [get_pins -hierarchical {u_soc/frame_memory/transport/fifo/rg?9:0?/Q?9?}] -to [get_pins -hierarchical {u_soc/frame_memory/transport/fifo/rg_w1?9:0?/D?9?}]
set_false_path -from [get_clocks rx_pixel] -to [get_pins -hierarchical {u_soc/frame_memory/transport/fault_sync?1:0?/D?0?}]
set_false_path -from [get_clocks rx_pixel] -to [get_pins -hierarchical {u_soc/frame_memory/transport/w_up_sync?1:0?/D?0?}]
# H04E: raw shared epoch reset may release at any phase, ONLY at the reset
# synchronizers. All downstream producer/pointer reset pins use local stage2
# and retain recovery/removal timing. Do not cut UI->PIX clocks or all RS pins.
set_false_path -to [get_pins -hierarchical {u_soc/frame_memory/transport/fifo/wr_reset?1:0?/C}]
set_false_path -to [get_pins -hierarchical {u_soc/frame_memory/transport/fifo/rd_reset?1:0?/C}]
# H04I snapshot-only reset synchronizers; functional SYS/UI snapshot registers
# use local stage2 releases. No additional data/reset blanket exceptions.
set_false_path -to [get_pins -hierarchical {status_cdc/sys_reset?1:0?/C}]
set_false_path -to [get_pins -hierarchical {status_cdc/ui_reset?1:0?/C}]

# H04W ONLY: precise first-stage single-bit async CDC and PIX reset-release C.
# No UI second-stage D, UI reset C, functional reset C, SYS/OUT or CPU path is excluded.
set_false_path -from [get_clocks ddrphy_clkin] -to [get_pins -hierarchical {u_soc/frame_memory/fault_monitor/arm_pipe?1:0?/D?0?}]
set_false_path -from [get_clocks rx_pixel] -to [get_pins -hierarchical {u_soc/frame_memory/fault_monitor/ack_pipe?1:0?/D?0?}]
set_false_path -from [get_clocks ddrphy_clkin] -to [get_pins -hierarchical {u_soc/frame_memory/fault_monitor/pix_snapshot/req_pipe?1:0?/D?0?}]
set_false_path -from [get_clocks rx_pixel] -to [get_pins -hierarchical {u_soc/frame_memory/fault_monitor/pix_snapshot/ack_pipe?1:0?/D?0?}]
set_false_path -from [get_clocks rx_pixel] -to [get_pins -hierarchical {u_soc/frame_memory/fault_monitor/pix_snapshot/data_pipe?1:0?/D?0?}]
set_false_path -from [get_clocks ddrphy_clkin] -to [get_pins -hierarchical {u_soc/frame_memory/fault_monitor/pix_release?1:0?/C}]
set_false_path -from [get_clocks ddrphy_clkin] -to [get_pins -hierarchical {u_soc/frame_memory/fault_monitor/pix_snapshot/sys_reset?1:0?/C}]

# H18: only the result mailbox's two-flop SYS reset-release synchronizer C.
# Functional SYS registers use its local stage2; no data/CPU timing exceptions.
set_false_path -to [get_pins -hierarchical {result_cdc/sys_release?1:0?/C}]


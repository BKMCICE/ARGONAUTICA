# REFERENCE-PLANE BUDGET ONLY; unknown PHY AC and PCB skew NOT qualified.
# MS7210 1281=04 inverts its input clock, matching official loop reference.
set_input_delay -clock [get_clocks {rx_pixel}] -max 0 [get_ports {hdmi_rx_r[*] hdmi_rx_g[*] hdmi_rx_b[*] hdmi_rx_de hdmi_rx_hs hdmi_rx_vs}]
set_input_delay -clock [get_clocks {rx_pixel}] -min 0 [get_ports {hdmi_rx_r[*] hdmi_rx_g[*] hdmi_rx_b[*] hdmi_rx_de hdmi_rx_hs hdmi_rx_vs}]
set_output_delay -clock [get_clocks {tx_status}] -clock_fall -max 0 [get_ports {hdmi_r[*] hdmi_g[*] hdmi_b[*] hdmi_de hdmi_hs hdmi_vs}]
set_output_delay -clock [get_clocks {tx_status}] -clock_fall -min 0 [get_ports {hdmi_r[*] hdmi_g[*] hdmi_b[*] hdmi_de hdmi_hs hdmi_vs}]
set_clock_groups -name {rx_diag_cdc} -asynchronous -group [get_clocks {sys_clk tx_status}] -group [get_clocks {rx_pixel}]

# H04D diagnostic CDC constraints; physical coverage/raw timing NOT YET ACCEPTED.
# PDS constraint check uses pre-synthesis vector cells, not mapped bit cells.
# ? matches a literal bracket position; full path plus Q/D index is unique.
# Each Gray Q -> first-stage D data path is bounded by the faster clock period.
# Hold is asynchronous only on those paths; second stages remain fully timed.
# wg Gray bit 0; synthesized MSB may alias binary MSB.
set_max_delay 6.734 -datapath_only -from [get_pins -hierarchical {u_soc/frame_memory/transport/fifo/wg?9:0?/Q?0?}] -to [get_pins -hierarchical {u_soc/frame_memory/transport/fifo/wg_r1?9:0?/D?0?}]
set_false_path -hold -from [get_pins -hierarchical {u_soc/frame_memory/transport/fifo/wg?9:0?/Q?0?}] -to [get_pins -hierarchical {u_soc/frame_memory/transport/fifo/wg_r1?9:0?/D?0?}]

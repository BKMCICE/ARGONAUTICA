define_attribute {p:flash_wp_n} {PAP_IO_LOC} {R13}
define_attribute {p:flash_wp_n} {PAP_IO_VCCIO} {3.3}
define_attribute {p:flash_wp_n} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:flash_wp_n} {PAP_IO_DRIVE} {4}
define_attribute {p:flash_wp_n} {PAP_IO_SLEW} {SLOW}

# H19 runtimeFlash flash_hold_n: physical board configuration pin, persist=None.
define_attribute {p:flash_hold_n} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:flash_hold_n} {PAP_IO_LOC} {T14}
define_attribute {p:flash_hold_n} {PAP_IO_VCCIO} {3.3}
define_attribute {p:flash_hold_n} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:flash_hold_n} {PAP_IO_DRIVE} {4}
define_attribute {p:flash_hold_n} {PAP_IO_SLEW} {SLOW}

# H19: only the external asynchronous MISO source is exempted.
# Required physical gate: its sole fanout is synchronizer stage0; stage0->stage1 stays timed.
set_false_path -from [get_ports {flash_miso}]
